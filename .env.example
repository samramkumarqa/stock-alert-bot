# Copy to .env for local runs (never commit .env). On GitHub, add these as repository secrets.

# Telegram (recommended): create a bot with @BotFather, message it once,
# then open https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (optional): Gmail address + a Gmail App Password (not your normal password)
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Strategy (defaults shown)
# THRESHOLD_PCT=1.5
# MAX_ALERTS=5          # top N gainers to alert (0 = all)
# BASELINE_TIME=09:30
# CHECK_TIME=09:45
